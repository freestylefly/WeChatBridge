# Swift / SwiftPM
.build/
.swiftpm/

# Build output
dist/

# Xcode, if anyone opens the package there
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
*.xcresult

# Working notes: design records, implementation plans, field measurements and
# the research behind the WeChat automation. They read as the diary of one Mac
# and one WeChat build rather than as documentation, so they stay local.
/DUKOU_MACOS_IMPLEMENTATION_RESEARCH.md

# One-off probes used to recover WeChat's export behaviour. The verified
# implementation lives in macos/Sources/ and macos/Tests/; shipping these would
# ship a second, unmaintained automation client beside the app.
/macos/Scripts/wechat-*
/macos/Scripts/verify-wechat-export.py

# macOS
.DS_Store
._*

# Local diagnostics
*.log

# Editors
.vscode/
.idea/
*.swp

# Signing material, should it ever be generated locally
*.p12
*.pfx
*.pem
*.key
*.cer
*.p8

# A local run of the licence server: its generated issuing key, its config and
# the public key that key implies. Whole-directory rather than per-file because
# anything dropped in here to make `go run ./cmd/wcb` work is by definition
# something that must not reach the repository — and the private key in
# particular must never be committed, here or anywhere else.
/server/.local/

# Local environment files
.env
.env.*
!.env.example

# Local design exploration output
output/

# Windows/.NET build output and local packaging artifacts
windows/**/bin/
windows/**/obj/
windows/artifacts/
windows/**/*.msix
windows/**/*.appx

# Local agent workspace and private session context
AGENTS.md
IDENTITY.md
IDENTITY_CONFIRMATION.md
WeChatBridge.identity.json
MEMORY.md
memory/
.cowork-temp/

# Python byte-code from local scripts
__pycache__/
*.pyc
