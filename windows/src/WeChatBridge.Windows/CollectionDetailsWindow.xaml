<Window x:Class="WeChatBridge.Windows.CollectionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        xmlns:c="clr-namespace:WeChatBridge.Windows.Components"
        Title="{loc:Loc Key='批次详情'}" Width="490" MinWidth="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" Topmost="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Components/CollectionComponents.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkColor}"/><Setter Property="FontSize" Value="12"/></Style>
            <Style x:Key="BatchTab" TargetType="c:CollectionButton" BasedOn="{StaticResource {x:Type c:CollectionButton}}">
                <Setter Property="Kind" Value="Segment"/><Setter Property="Margin" Value="0,0,4,4"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandSoftColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrandColor}"/>
                </DataTrigger></Style.Triggers>
            </Style>
            <DataTemplate x:Key="ReferenceTemplate">
                <Border Background="{DynamicResource SunkenColor}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrandColor}" VerticalAlignment="Center"/>
                            <c:CollectionButton Grid.Column="1" Content="{loc:Loc Key='复制这条文字'}" Click="CopyKeyword_Click" Kind="Ghost" Padding="5,2" MinHeight="24" FontSize="10"/>
                        </Grid>
                        <TextBlock Text="{Binding SenderTime}" FontSize="10.5" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,0,0,7"/>
                        <TextBlock Text="{Binding Content}" Foreground="{DynamicResource InkColor}" TextWrapping="Wrap" FontSize="12.5" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <c:CollectionCard Margin="14" CornerRadius="22" Background="{DynamicResource SurfaceColor}"
            BorderBrush="{DynamicResource StrokeColor}" BorderThickness="1">
        <c:CollectionCard.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.12"/></c:CollectionCard.Effect>
        <StackPanel>
            <Grid Margin="20,18,14,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource BrandSoftColor}">
                    <Path Data="{StaticResource CollectionFolderIcon}" Stroke="{DynamicResource BrandColor}" StrokeThickness="1.5" Width="23" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key='批次详情'}" FontSize="15" FontWeight="SemiBold"/>
                    <Border Background="{DynamicResource BrandSoftColor}" CornerRadius="6" Padding="6,2" Margin="0,5,0,0" HorizontalAlignment="Left">
                        <TextBlock x:Name="Status" FontSize="10" Foreground="{DynamicResource BrandColor}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <c:CollectionButton x:Name="MoreButton" Kind="Icon" AutomationProperties.Name="{loc:Loc Key=更多}" Content="···" FontSize="17"
                            ToolTip="{loc:Loc Key='更多'}" Click="More_Click" Padding="7,1" Margin="0,0,3,0"/>
                    <c:CollectionButton x:Name="CloseButton" Kind="Icon" AutomationProperties.Name="{loc:Loc Key=关闭}"
                            ToolTip="{loc:Loc Key='关闭'}" Click="Close_Click" Cursor="Hand">
                        <Path Data="{StaticResource CollectionCloseIcon}" Stroke="{DynamicResource InkSecondaryColor}" StrokeThickness="1.4" Width="14" Height="14"/>
                    </c:CollectionButton>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SummaryText" Margin="20,18,20,14" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Border x:Name="RecentPanel" Margin="18,0,18,0" Padding="12,10" CornerRadius="12" Background="{DynamicResource SunkenColor}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="RecentChat" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="RecentBatch" Grid.Column="1" FontSize="10" Foreground="{DynamicResource InkSecondaryColor}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="LastRange" FontSize="10.5" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Hint" Margin="18,10,18,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryColor}"/>
            <!-- One detail surface, one scroll area, one selected batch. -->
            <Border x:Name="ManagementPanel" Visibility="Collapsed" Margin="18,14,18,0" Padding="0,12,0,0"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource StrokeColor}">
                <c:CollectionScrollViewer x:Name="BatchScroll" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key='批次详情'}" FontSize="11" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ReferenceTabs" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <c:CollectionButton Content="{Binding ReferenceTitle}" Click="ReferenceTab_Click" Style="{StaticResource BatchTab}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <c:CollectionComboBox x:Name="ReferenceSelector" DisplayMemberPath="ReferenceTitle" SelectionChanged="Reference_Changed" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LatestChat" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <c:CollectionButton Grid.Column="1" x:Name="RenameButton" Content="{loc:Loc Key='会话备注'}" Kind="Ghost" Click="Rename_Click"/>
                        </Grid>
                        <TextBlock x:Name="LatestBatch" FontSize="10.5" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="NameEditor" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Text="{loc:Loc Key='会话备注（可选）'}" FontSize="11" Margin="0,0,0,6"/>
                            <c:CollectionTextBox Placeholder="{loc:Loc Key=群或联系人名称}" x:Name="ChatNameInput" Text="{Binding ChatName, UpdateSourceTrigger=PropertyChanged}"/>
                            <c:CollectionButton Content="{loc:Loc Key='识别当前微信'}" Click="Recognize_Click" Kind="Ghost" HorizontalAlignment="Left" Margin="0,3,0,2"/>
                            <c:CollectionCheckBox x:Name="DefaultNameCheck" IsChecked="{Binding IsDefault}" Margin="0,6,0,10" FontSize="10.5"
                                      Foreground="{DynamicResource InkSecondaryColor}">
                                <TextBlock Text="{loc:Loc Key='用于本组未命名和后续批次'}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryColor}"/>
                            </c:CollectionCheckBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <c:CollectionButton Content="{loc:Loc Key='取消'}" Kind="Ghost" Click="CancelName_Click" Margin="0,0,6,0"/>
                                <c:CollectionButton Kind="Primary" Content="{loc:Loc Key='保存名称'}" Click="SaveName_Click" Padding="12,5"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="LatestReference">
                            <TextBlock Text="{Binding Range}" FontSize="10.5" Foreground="{DynamicResource InkSecondaryColor}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding BoundaryReferences}" ItemTemplate="{StaticResource ReferenceTemplate}">

                            </ItemsControl>
                            <c:CollectionExpander x:Name="ReferenceMore" Header="{loc:Loc Key='更多定位参考'}" FontSize="11" Margin="0,4,0,8"
                                      Visibility="{Binding HasAdditionalReferences, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding AdditionalReferences}" ItemTemplate="{StaticResource ReferenceTemplate}" Margin="0,8,0,0"/>
                            </c:CollectionExpander>
                            <TextBlock Text="{Binding ReferenceNotice}" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryColor}" FontSize="11"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,2">
                            <c:CollectionButton Content="{loc:Loc Key='查看原始文件'}" Click="Reveal_Click" Kind="Ghost" Margin="0,0,6,0"/>
                            <c:CollectionButton Content="{loc:Loc Key='批次操作…'}" Click="BatchMore_Click" Kind="Ghost"/>
                        </WrapPanel>
                    </StackPanel>
                </c:CollectionScrollViewer>
            </Border>
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="18,10,18,0" FontSize="11" Foreground="{DynamicResource WarnInkColor}"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringToVisibility}}"/>
            <WrapPanel Margin="18,8,18,0">
                <c:CollectionButton x:Name="ResumeButton" Kind="Ghost" Content="{loc:Loc Key='继续收集'}" Click="Resume_Click" Margin="0,0,6,0"/>
                <c:CollectionButton x:Name="UndoButton" Kind="Ghost" Content="{loc:Loc Key='撤销删除'}" Click="Undo_Click"/>
            </WrapPanel>
            <Grid Margin="18,8,18,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:CollectionButton Visibility="Collapsed" x:Name="ManageButton" Kind="Ghost" Content="{loc:Loc Key='批次详情'}" Click="Manage_Click" HorizontalAlignment="Left" Padding="0,8"/>
                <c:CollectionButton x:Name="DeliverButton" Grid.Column="1" Kind="Primary" Content="{loc:Loc Key='选择去向…'}" Click="Deliver_Click" Padding="18,10" FontSize="12"/>
            </Grid>
        </StackPanel>
    </c:CollectionCard>
</Window>
