<Window x:Class="WeChatBridge.Windows.CollectionDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        xmlns:c="clr-namespace:WeChatBridge.Windows.Components"
        Title="{loc:Loc Key='选择去向'}" Width="440" MinWidth="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Components/CollectionComponents.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkColor}"/><Setter Property="FontSize" Value="12"/></Style>
    </ResourceDictionary></Window.Resources>
    <c:CollectionCard Margin="14" CornerRadius="22">
        <c:CollectionCard.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.14"/></c:CollectionCard.Effect>
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key='选择去向'}" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Summary" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,7,16,0"/>
                </StackPanel>
                <c:CollectionButton Grid.Column="1" Kind="Icon" Click="Cancel_Click" VerticalAlignment="Top"
                                    AutomationProperties.Name="{loc:Loc Key=关闭}" ToolTip="{loc:Loc Key=继续收集}">
                    <Path Data="{StaticResource CollectionCloseIcon}" Stroke="{DynamicResource InkSecondaryColor}" StrokeThickness="1.4" Width="14" Height="14"/>
                </c:CollectionButton>
            </Grid>
            <c:CollectionScrollViewer x:Name="DeliveryScroll" Grid.Row="1" MaxHeight="470" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key='选择一个已安装应用，或保存原始文件。'}" Foreground="{DynamicResource InkSecondaryColor}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <c:CollectionTargetList x:Name="Targets" SelectionMode="Single" MaxHeight="285" SelectionChanged="Target_Changed"
                                            AutomationProperties.Name="{loc:Loc Key=交付目标}">
                        <c:CollectionTargetList.ItemTemplate><DataTemplate>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceColor}" VerticalAlignment="Center" Margin="0,0,11,0">
                                    <Grid>
                                        <TextBlock x:Name="FallbackBadge" Text="{Binding Badge}" Visibility="Collapsed" Foreground="{DynamicResource BrandColor}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="25" Height="25"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter TargetName="FallbackBadge" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate></c:CollectionTargetList.ItemTemplate>
                    </c:CollectionTargetList>
                    <StackPanel x:Name="ScenePanel" Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc Key='附加场景（可选）'}" FontSize="11" Foreground="{DynamicResource InkSecondaryColor}" Margin="0,0,0,7"/>
                        <c:CollectionComboBox x:Name="Scenes" DisplayMemberPath="Title" AutomationProperties.Name="{loc:Loc Key=场景}"/>
                    </StackPanel>
                    <TextBlock x:Name="DestinationHint" Text="{loc:Loc Key='附加到应用后，请在目标应用确认附件。'}" Margin="0,12,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryColor}"/>
                    <TextBlock x:Name="Error" Margin="0,10,0,0" Foreground="{DynamicResource DangerColor}" TextWrapping="Wrap"/>
                </StackPanel>
            </c:CollectionScrollViewer>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <c:CollectionButton Kind="Ghost" Click="Cancel_Click" HorizontalAlignment="Left" Margin="0,0,8,0">
                    <TextBlock Text="{loc:Loc Key='继续收集'}" TextWrapping="Wrap" Foreground="{DynamicResource InkColor}"/>
                </c:CollectionButton>
                <c:CollectionButton Grid.Column="1" x:Name="Confirm" Content="{loc:Loc Key='请选择交付目标'}" IsEnabled="False" Kind="Primary" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </c:CollectionCard>
</Window>
