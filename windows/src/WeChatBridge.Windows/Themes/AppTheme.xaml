<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WeChatBridge.Windows">
    <!-- The app's whole visual theme in one mergeable dictionary. App.xaml
         merges it for the main window, and each floating picker merges it
         into its own resources — the share-target helper links this same file
         and shows the picker without the app running, so nothing here may
         depend on Application.Current. -->

    <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibility" />
    <local:ExpandGlyphConverter x:Key="ExpandGlyph" />
    <local:ByteCountTextConverter x:Key="ByteCountText" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ============== Palette: the light branch of macOS Theme.swift ==============
         Keys ending in Color are the macOS token names, verbatim values. -->
    <SolidColorBrush x:Key="BrandColor" Color="#FF14C653" />
    <SolidColorBrush x:Key="BrandHoverColor" Color="#FF18D45B" />
    <SolidColorBrush x:Key="BrandPressedColor" Color="#FF0FA845" />
    <SolidColorBrush x:Key="BrandSoftColor" Color="#FFE9FFF2" />
    <SolidColorBrush x:Key="BrandTintColor" Color="#1F14C653" />
    <SolidColorBrush x:Key="OnBrandColor" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="BackgroundColor" Color="#FFF8FAF9" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SunkenColor" Color="#FFF2F5F3" />
    <SolidColorBrush x:Key="HoverColor" Color="#FFF4F7F5" />
    <SolidColorBrush x:Key="SelectedColor" Color="#FFE8EEEA" />
    <SolidColorBrush x:Key="ChoiceDividerColor" Color="#FFD9DFDB" />

    <SolidColorBrush x:Key="StrokeColor" Color="#FFE5EAE7" />
    <SolidColorBrush x:Key="StrokeStrongColor" Color="#FFD8DEDA" />
    <SolidColorBrush x:Key="StrokeSoftColor" Color="#FFF0F2F0" />
    <SolidColorBrush x:Key="ButtonBorderColor" Color="#FFDFE4E1" />
    <SolidColorBrush x:Key="InputStrokeColor" Color="#FF8C948F" />
    <SolidColorBrush x:Key="HairlineColor" Color="#19000000" />

    <SolidColorBrush x:Key="InkColor" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="InkSecondaryColor" Color="#FF687078" />
    <SolidColorBrush x:Key="InkTertiaryColor" Color="#FF9AA1A6" />
    <SolidColorBrush x:Key="DisabledColor" Color="#FFC8CECB" />
    <SolidColorBrush x:Key="SecondaryActionTextColor" Color="#FF4A5055" />

    <SolidColorBrush x:Key="BlueColor" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="WarningColor" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="WarningSoftColor" Color="#FFFFF4E5" />
    <SolidColorBrush x:Key="DangerColor" Color="#FFFF453A" />
    <SolidColorBrush x:Key="DangerSoftColor" Color="#FFFFEFEE" />

    <!-- Status semantics: a dot+ink pair, the way macOS draws 已送达. -->
    <SolidColorBrush x:Key="LiveInkColor" Color="#FF0FA845" />
    <SolidColorBrush x:Key="LiveFillColor" Color="#FFE9FFF2" />
    <SolidColorBrush x:Key="WarnInkColor" Color="#FFB54708" />
    <SolidColorBrush x:Key="WarnFillColor" Color="#FFFFF4E5" />
    <SolidColorBrush x:Key="NeutralInkColor" Color="#FF687078" />
    <SolidColorBrush x:Key="NeutralFillColor" Color="#FFF2F5F3" />

    <!-- A plain rounded button — macOS secondary control: white face,
         hairline border, 10px radius, hover tint. -->
    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkColor}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ButtonBorderColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The filled brand button — macOS's prominent action (保存更改, 新建). -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OnBrandColor}" />
        <Setter Property="Background" Value="{DynamicResource BrandColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandHoverColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandPressedColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger text button — 删除 sits next to 保存更改 in red ink only. -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- macOS toggle: a 38×22 pill, white knob, brand green when on.
         Apply to a CheckBox — IsChecked drives the knob. -->
    <Style x:Key="MacToggle" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="track" Width="38" Height="22" CornerRadius="11"
                                Background="{DynamicResource DisabledColor}" />
                        <Border x:Name="knob" Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource SurfaceColor}"
                                HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource BrandColor}" />
                            <Setter TargetName="knob" Property="Margin" Value="18,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded input — the settings search field / edit boxes. -->
    <Style x:Key="MacField" TargetType="TextBox">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkColor}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrandColor}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrandTintColor}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrandColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet section header label + the hairline under it (SettingsSection). -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkSecondaryColor}" />
    </Style>

    <!-- Status pill kept for panes that still use it; new work draws the
         dot+text pair (StatusDot style + ink) like macOS does. -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource NeutralFillColor}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Live">
                <Setter Property="Background" Value="{DynamicResource LiveFillColor}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource WarnFillColor}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource NeutralInkColor}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Live">
                <Setter Property="Foreground" Value="{DynamicResource LiveInkColor}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource WarnInkColor}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{DynamicResource NeutralInkColor}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Live">
                <Setter Property="Fill" Value="{DynamicResource BrandColor}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                <Setter Property="Fill" Value="{DynamicResource WarningColor}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Card: the white rounded surface every pane section sits on. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Soft explanatory panel (macOS Panel). -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SunkenColor}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ==================== Floating pickers ====================
         Styles used only by the share-flow panels: EntryPickerWindow,
         ScenePickerWindow and TargetPickerWindow. They live in the theme
         because the share-target helper links the same file and must not
         carry a second copy of the palette. -->

    <!-- The round ghost close button in a picker's header. -->
    <Style x:Key="PickerCloseButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Content" Value="&#xE106;" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource InkTertiaryColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="关闭" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="12"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SunkenColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A keycap: the little bordered chip a shortcut hint is printed on. -->
    <Style x:Key="KeycapChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SunkenColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongColor}" />
        <Setter Property="BorderThickness" Value="1,1,1,1.5" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The digit chip printed at a picker's right edge — same keycap look,
         just horizontally centred text. -->
    <Style x:Key="ShortcutChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3.5,0" />
        <Setter Property="MinHeight" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Small secondary button for picker footers (直接转发): sunken face,
         hairline border — quieter than SettingsButton. -->
    <Style x:Key="PickerGhostButton" TargetType="Button">
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryActionTextColor}" />
        <Setter Property="Background" Value="{DynamicResource SunkenColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary pill in a picker footer (使用此场景). -->
    <Style x:Key="PickerPrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OnBrandColor}" />
        <Setter Property="Background" Value="{DynamicResource BrandColor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandHoverColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandPressedColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
