<Window x:Class="WeChatBridge.Windows.TextImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        Title="{loc:Loc Key='导入聊天文字'}" Width="620" Height="480"
        MinWidth="460" MinHeight="360" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:Loc Key='聊天名称（可选）'}" Foreground="{StaticResource InkColor}"/>
        <TextBox x:Name="ChatNameInput" Grid.Row="1" Margin="0,6,0,12" Padding="8,5" MaxLength="200"/>
        <TextBlock Grid.Row="2" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource InkSecondaryColor}"
                   Text="{loc:Loc Key='粘贴聊天文字；图片和视频需要另外提供。导入后可选择发送目标。'}"/>
        <TextBox x:Name="BodyInput" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="10"
                 TextChanged="BodyInput_TextChanged"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc Key='取消'}" IsCancel="True" Style="{StaticResource SettingsButton}" MinWidth="72"/>
            <Button x:Name="ImportButton" Content="{loc:Loc Key='导入'}" IsDefault="True" IsEnabled="False"
                    Margin="8,0,0,0" Style="{StaticResource SettingsButton}" MinWidth="72" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
