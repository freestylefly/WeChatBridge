<Window x:Class="WeChatBridge.Windows.Activation.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:WeChatBridge.Windows" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{loc:Loc Key='微信登录'}" Width="480" Height="600" WindowStyle="None"
 Background="{StaticResource SurfaceColor}" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 Icon="/WeChatBridge.Windows;component/Assets/AppIcon.png">
 <!-- Same shell as the redeem and onboarding windows. No AllowsTransparency: a layered
      window disables hardware acceleration and the DPI story every other pane relies on.
      The rounded card is a Border instead. -->
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" CornerRadius="12" GlassFrameThickness="0"
 ResizeBorderThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
 <Style x:Key="GateButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
 <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="104"/><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="GatePrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
 <Setter Property="MinHeight" Value="38"/><Setter Property="MinWidth" Value="112"/><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
 <Setter Property="Foreground" Value="{StaticResource InkColor}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Body" TargetType="TextBlock"><Setter Property="FontSize" Value="13.5"/><Setter Property="LineHeight" Value="22"/>
 <Setter Property="Foreground" Value="{StaticResource InkSecondaryColor}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="12"/>
 <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource StrokeColor}"/>
 <Setter Property="Background" Value="{StaticResource SurfaceColor}"/></Style>
 </Window.Resources>
 <Border BorderBrush="{StaticResource StrokeColor}" BorderThickness="1" CornerRadius="12"><Grid>
 <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid MouseLeftButtonDown="OnDragMove" Margin="20,0,12,0">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
 <Image Source="/WeChatBridge.Windows;component/Assets/AppIcon.png" Width="28" Height="28"/>
 <TextBlock Text="{loc:Loc Key='微信登录'}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
 </StackPanel>
 <Button Width="32" Height="32" MinHeight="32" MinWidth="0" Padding="0" HorizontalAlignment="Right" Content="×" FontSize="22"
 Style="{StaticResource GateButton}" Background="Transparent" ToolTip="{loc:Loc Key='关闭'}" IsCancel="True"
 shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
 </Grid>
 <Grid Grid.Row="1" Margin="28,22,28,24">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
 <TextBlock Style="{StaticResource Heading}" Text="{loc:Loc Key='扫码登录'}" />
 <TextBlock x:Name="IntroText" Style="{StaticResource Body}" Margin="0,8,0,0"
 Text="{loc:Loc Key='用微信扫描下方二维码即可登录。登录只用于把这次购买记在你名下，不会读取你的聊天记录。'}" />
 </StackPanel>

 <!-- The code. Held in a fixed-size sunken card so the window does not resize when
      the image arrives, and so the eye has somewhere to land while it waits.
      The image and the placeholder overlay rather than replace each other, so the
      card needs a Grid inside it — a Border takes exactly one child. -->
 <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource SunkenColor}"
 Width="248" Height="248" Margin="0,20,0,0" HorizontalAlignment="Center">
 <Grid>
 <Image x:Name="QrImage" Stretch="Uniform" Width="224" Height="224"
 RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"
 AutomationProperties.Name="{loc:Loc Key='登录二维码'}" />
 <TextBlock x:Name="QrPlaceholder" Style="{StaticResource Body}" TextAlignment="Center" VerticalAlignment="Center"
 Margin="16" Text="{loc:Loc Key='正在获取二维码…'}" />
 </Grid>
 </Border>

 <StackPanel Grid.Row="2" Margin="0,18,0,0">
 <TextBlock x:Name="StatusText" Style="{StaticResource Body}" Foreground="{StaticResource InkColor}" TextAlignment="Center"
 AutomationProperties.LiveSetting="Assertive" />
 <!-- Shown only when the server hands back a URL. A user whose camera will not focus
      can still open it, which is the difference between "log in" and "give up". -->
 <TextBlock x:Name="AuthorizeText" Style="{StaticResource Body}" FontSize="11" Margin="0,10,0,0"
 Foreground="{StaticResource InkTertiaryColor}" TextAlignment="Center" TextWrapping="Wrap"
 Visibility="Collapsed" AutomationProperties.Name="{loc:Loc Key='扫码链接'}" />
 </StackPanel>

 <Grid Grid.Row="3" Margin="0,18,0,0">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock x:Name="CountdownText" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center"
 Foreground="{StaticResource InkTertiaryColor}" Text="{loc:Loc Key='二维码有效期 5 分钟'}" />
 <StackPanel Orientation="Horizontal" Grid.Column="1">
 <Button x:Name="FinishButton" Style="{StaticResource GatePrimary}" Content="{loc:Loc Key='完成'}"
 Click="OnFinishClicked" IsDefault="True" Visibility="Collapsed" Margin="0,0,8,0" />
 <Button x:Name="StartButton" Style="{StaticResource GatePrimary}" Content="{loc:Loc Key='获取二维码'}"
 Click="OnStartClicked" IsDefault="True" IsEnabled="False" />
 </StackPanel>
 </Grid>
 </Grid>
 </Grid></Border>
</Window>
