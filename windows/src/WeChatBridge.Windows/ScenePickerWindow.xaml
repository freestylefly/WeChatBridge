<Window x:Class="WeChatBridge.Windows.ScenePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        Title="{loc:Loc Key='选择场景'}" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Opacity="0" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Loaded="OnLoaded">
    <!-- Same FloatingCapsule chrome as the target picker: Radius.panel=14,
         SurfaceColor, hairline stroke, soft shadow in the margin. -->
    <Border x:Name="Root" Margin="14" Padding="0" CornerRadius="14"
            Background="{StaticResource SurfaceColor}"
            BorderBrush="{StaticResource StrokeColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.20" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="14,12,10,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8"
                        Background="{StaticResource BrandTintColor}"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#xEA80;" FontSize="14"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource BrandColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key='选择场景'}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource InkColor}" />
                    <TextBlock Text="{loc:Loc Key='每次转发只加载一个场景，也可以直接转发。'}" FontSize="10.5"
                               Margin="0,1,0,0" Foreground="{StaticResource InkTertiaryColor}" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Top"
                        Style="{StaticResource PickerCloseButton}" Click="OnCloseClicked" />
            </Grid>
            <ListBox x:Name="SceneList" Height="200" Margin="6,0,6,2" BorderThickness="0"
                     Background="Transparent" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="row" CornerRadius="9" Padding="9,0"
                                            Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="row" Property="Background"
                                                    Value="{StaticResource HoverColor}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="row" Property="Background"
                                                    Value="{StaticResource BrandTintColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- checkmark.circle / circle — the macOS row's
                                 selection mark. -->
                            <Border x:Name="Tick" Width="17" Height="17" CornerRadius="8.5"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource StrokeStrongColor}"
                                    BorderThickness="1">
                                <TextBlock x:Name="TickMark" Text="&#xE73E;" FontSize="10"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource OnBrandColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{StaticResource InkColor}" />
                                <TextBlock Text="{Binding SummaryText}" FontSize="10.5"
                                           Margin="0,1,0,0"
                                           Foreground="{StaticResource InkSecondaryColor}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Margin="10,0,0,0"
                                    Style="{StaticResource ShortcutChip}"
                                    Visibility="{Binding Shortcut, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding Shortcut}" FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkTertiaryColor}"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="Tick" Property="Background"
                                        Value="{StaticResource BrandColor}" />
                                <Setter TargetName="Tick" Property="BorderBrush"
                                        Value="{StaticResource BrandColor}" />
                                <Setter TargetName="TickMark" Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,2,0,0" Padding="14,7,14,9"
                    BorderBrush="{StaticResource StrokeSoftColor}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource KeycapChip}">
                            <TextBlock Text="Esc" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondaryColor}" />
                        </Border>
                        <TextBlock Text="{loc:Loc Key='取消'}" FontSize="10.5" Margin="4,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkTertiaryColor}" />
                        <Border Style="{StaticResource KeycapChip}">
                            <TextBlock Text="1–9" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSecondaryColor}" />
                        </Border>
                        <TextBlock Text="{loc:Loc Key='选择'}" FontSize="10.5" Margin="4,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkTertiaryColor}" />
                        <TextBlock Text="{loc:Loc Key='90 秒内有效'}" FontSize="10.5"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource InkTertiaryColor}" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Button x:Name="DirectButton" Content="{loc:Loc Key='直接转发'}" HorizontalAlignment="Left"
                                Style="{StaticResource PickerGhostButton}" IsCancel="True"
                                Click="OnDirectClicked" />
                        <Button x:Name="ConfirmButton" Content="{loc:Loc Key='使用此场景'}" HorizontalAlignment="Right"
                                Style="{StaticResource PickerPrimaryButton}" IsDefault="True"
                                IsEnabled="False" Click="OnConfirmClicked" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
